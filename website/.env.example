# Creem API keys (get from https://creem.io/dashboard)
CREEM_API_KEY=creem_test_your_key_here
CREEM_WEBHOOK_SECRET=whsec_your_secret_here
CREEM_PRODUCT_ID=prod_your_product_id_here

# Creem API base URL
# Test:       https://test-api.creem.io
# Production: https://api.creem.io
CREEM_API_BASE_URL=https://test-api.creem.io

# License encryption secret (generate with: openssl rand -hex 32)
LICENSE_SECRET=your_random_secret_key_here

# Environment
NODE_ENV=development
# Public production URL. Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=https://www.tokentint.xyz

# Mixpanel website analytics (public project token; only defined web_ events are sent)
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_ANALYTICS_ENABLED=true
